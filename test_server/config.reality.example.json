{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-reality",
      "listen": "0.0.0.0:443",
      "users": [
        {
          "id": "<UUID from test_server uuid>",
          "email": "vision",
          "flow": "xtls-rprx-vision"
        }
      ],
      "reality": {
        "dest": "www.microsoft.com:443",
        "server_names": [
          "www.microsoft.com"
        ],
        "private_key": "<Private key from test_server x25519>",
        "short_ids": [
          "<short ID: 1-16 hex digits, e.g. openssl rand -hex 8>"
        ],
        "max_time_diff_ms": 60000
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "rules": [
      {
        "ip_private": true,
        "outbound": "block"
      }
    ],
    "final": "direct"
  }
}
