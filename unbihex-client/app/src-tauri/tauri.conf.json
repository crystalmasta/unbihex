{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unbihex",
  "version": "0.1.0",
  "identifier": "com.unbihex.client",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Unbihex",
        "width": 1000,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "VPN-клиент на ядре Unbihex",
    "publisher": "Crystalmasta",
    "copyright": "© 2026 Crystalmasta (github.com/crystalmasta)",
    "homepage": "https://github.com/crystalmasta",
    "license": "MPL-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
